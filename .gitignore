# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin
# Windows 预编译产物（启动服务.bat 自动生成/使用）
/login.exe
/credit.exe
/wb2api.exe
/signin_bin.exe
/signin.exe
/trial.exe
/task.exe
/acct.exe
/stats.exe
# 换版前留的旧产物备份（*.exe.bak / *.exe.bak-日期 / *.exe.<tag>.bak）
*.exe.bak*
*.exe.*.bak*

# Windows 下误重定向 nul 设备产生的空文件（Git Bash 会落出实体文件）
/nul

# Runtime logs & distribution archive（本地定制）
logs/
workbuddy2api-dist.zip

# Session artifacts
.omo/
.v2c/
# Claude 本地配置（settings.local.json 的 curl 授权规则串内嵌真实 api_key，不得入库）
.claude/

# Config with secrets (use config.example.json)
config.json
# admin 热改写回（PATCH /admin/tasks 等）写盘前自动生成的备份（含真实配置，不得入库）
config.json.bak*

# Build artifacts
*.tmp
__pycache__/

# 运行时产物（API Key / 进程号 / 日志 / 工具草稿目录）
# 为什么显式列 .apikey：它不是 config.json 的别名，而是 login.sh 等工具单独落盘的密钥文件，
# 不写进这里会被 git add -A 直接提交（含明文 api_key）。
.apikey
.server.pid
wb2api.pid
*.log
draft_*_folder/
# 本地调试脚本目录（一次性观测脚本，不入库）
dev/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md

# 设计/计划文档（README.md 与 docs/ 定稿设计文档必须进版本库）
*.md
!README.md
!docs/DESIGN-v1.2.0-panel-manager.md

web/node_modules/
web/.next/
web/out/
